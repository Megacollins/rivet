# Copy to .env. Never commit .env. Testnet keys only.

# Diana endpoints (defaults shown)
RIVET_EVM_RPC=https://evm-testnet.qore.host
RIVET_REST=https://api-testnet.qore.host
RIVET_COMET_RPC=https://rpc-testnet.qore.host

# Operator account: classical eth_secp256k1 key that sends EVM transactions.
# QoreChain admits its EVM txs only after it registers an ML-DSA-87 key AND opens an EVM window.
RIVET_OPERATOR_KEY=
# 32-byte ML-DSA-87 seed (hex) for the same account's x/pqc key; signs Rivet attestations.
RIVET_PQC_SEED=
# The operator's 0x address (= attester)
RIVET_ATTESTER=

# Deployed RivetRegistry on Diana
RIVET_REGISTRY=

# Web app: allow THIS server to sign and publish reports (local operator only; leave unset when hosting)
RIVET_WEB_OPERATOR=
